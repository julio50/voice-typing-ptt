# fifo queue to hold temporary audio file names
audio_fifo=$(mktemp); rm "$audio_fifo" ; mkfifo "$audio_fifo"

## create a trap to remove temp files on untimely exit
cleanup() {
    rm -f /tmp/tmp.txt "$audio_fifo"
}
trap cleanup 0

# function to process audio files from queue
trans(){
    while read audio; do
        # Send audio file to whisper.cpp using curl
        curl_output=$(curl -s "http://192.168.1.57:8000/v1/audio/transcriptions" \
                        -H "Content-Type: multipart/form-data" \
                        -F "file=@$audio" \
                        -F "temperature=0.2" \
                        -F "response-format=json")

        # remove temporary audio file
        rm -f "$audio"
        
        # Extract text from JSON response using jq or fallback method
        if command -v jq >/dev/null 2>&1; then
            # Use jq if available
            text=$(echo "$curl_output" | jq -r '.text // empty')
        else
            # Fallback: extract text using grep and sed
            text=$(echo "$curl_output" | grep -o '"text":"[^"]*"' | sed 's/"text":"\(.*\)"/\1/')
        fi
        
        # If text extraction failed, try the original output as plain text
        if [[ -z "$text" ]]; then
            text="$curl_output"
        fi
        
        echo "$text"
        # Type text to terminal, in background
        
        # Convert to lowercase for case-insensitive comparison
        text_lower=$(echo "$text" | tr '[:upper:]' '[:lower:]')
        
        # Common whisper hallucinations and false positives blacklist
        blacklist=("thanks for watching" "thank you" "you" "yeah" "bye" 
                   "subscribe" "like and subscribe" "please subscribe"
                   "music" "[music]" "[applause]" "[laughter]"
                   "thank you for watching" "see you next time"
                   "bye bye" "okay" "um" "uh")
        
        # Check against blacklist
        is_blacklisted=false
        for phrase in "${blacklist[@]}"; do
            if [[ "$text_lower" == "$phrase" ]]; then
                is_blacklisted=true
                break
            fi
        done
        
        # Filter criteria: 
        # - More than 1 word
        # - At least 10 characters
        # - Not in blacklist
        # - No brackets (indicates non-speech sounds)
        word_count=$(echo "$text" | wc -w)
        char_count=${#text}
        
        if [[ $word_count -gt 1 ]] && [[ $char_count -ge 6 ]] \
            && [[ "$is_blacklisted" == "false" ]] \
            && [[ "$text" != *'['* ]] && [[ "$text" != *']'* ]]; then
            echo "[TYPING]: $text" >&2
            # Clean text of any non-printable characters
            clean_text=$(echo "$text" | tr -cd '[:print:][:space:]')
            ydotool type " $clean_text"
        else
            echo "[FILTERED]: $text (words:$word_count chars:$char_count blacklisted:$is_blacklisted)" >&2
        fi &
    done < "$audio_fifo"
    #cleanup
    rm -f "$audio_fifo"
}

# record audio in background
while true; do
    # Make temporary files to hold audio
    tmp=$(mktemp)
    # Remove it on exit
    trap 'rm "$tmp" ; exit' INT

    # Listen to the mic.
    # The `1 0.05 2%` part of this command trims minimal silence
    # from the beginning. 2% of max volume is considered silence here.
    # `1 0.5 3%` stops after a 0.5 second pause in speech.
    # If recording never stops, increase sound threshold from 3%
    # to 5% or more. This can happen with poor recording equipment
    # or noisy environments with heaters and fans going.

    start_time=$(date +%s.%N)
    rec -c 1 -r 44100 -t wav "$tmp" silence 1 0.05 2% 1 0.5 3%
    end_time=$(date +%s.%N)
    
    # Calculate duration in seconds
    duration=$(echo "$end_time - $start_time" | bc)
    
    # Only process if recording was at least 2 seconds
    if (( $(echo "$duration >= 2" | bc -l) )); then
        echo "$tmp"
    else
        # Remove short recording
        rm -f "$tmp"
    fi
done > "$audio_fifo" & #The `&` lets recording run in the background.

# run audio transciption handler
trans