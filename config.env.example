# Voice Typing Configuration
# Copy this file to config.env and customize your settings

# Whisper Server Configuration
WHISPER_SERVER=http://192.168.1.57:8002

# Audio Settings
AUDIO_SAMPLE_RATE=44100
AUDIO_FORMAT=wav
AUDIO_SILENCE_THRESHOLD=3%
AUDIO_MIN_DURATION=2

# Keyboard Configuration
KEYBOARD_NAME="Dell KB216 Wired Keyboard"
HOTKEY_1=50  # Left Shift keycode
HOTKEY_2=64  # Left Alt keycode

# Filtering Settings
MIN_WORD_COUNT=2
MIN_CHAR_COUNT=6
BLACKLIST_PHRASES="thanks for watching,thank you,you,yeah,bye,subscribe,music,okay,um,uh"

# Logging
LOG_LEVEL=INFO
LOG_FILE=voice_typing.log